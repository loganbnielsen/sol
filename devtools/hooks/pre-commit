#!/usr/bin/env bash
# Blocks the commit if tests fail or a performance regression is detected.
# Runs unit tests always; other suites when their infra is up.
#
# Install: bash cli/platform/local/scripts/install-hooks.sh
# Skip once: SOL_SKIP_HOOKS=1 git commit ...

[ "${SOL_SKIP_HOOKS:-0}" = "1" ] && exit 0

# ── Worktree guard ─────────────────────────────────────────────────────────────
# pipeline/tickets/ is only ever modified in the main checkout — never inside a worktree
# branch — with one exception (REFAC-077): a ticket's own final commit may move its
# file from READY_FOR_ENGINEERING/<id>.md to DONE/<id>.md, so that move rides into
# main inside the PR's squash-merge commit instead of a separate main-only commit.
#
# The exception is judged by *file name*, not by how much prose the commit added
# (BUG-023). It used to lean on git's rename detection at its default 50%
# similarity, and the workflow appends completion notes immediately before the
# move — so a small ticket with substantial notes came out as an add plus a
# delete and was refused, twice, on exactly the tickets with the most to
# document. A move is a move if the file name is unchanged; similarity is not
# the question anyone was asking.
GIT_DIR_ABS="$(git rev-parse --absolute-git-dir 2>/dev/null)"
if printf '%s\n' "$GIT_DIR_ABS" | grep -q "/worktrees/"; then
  STAGED_TICKETS="$(git diff --cached --name-only | grep '^pipeline/tickets/' || true)"
  if [ -n "$STAGED_TICKETS" ]; then
    # -M10% so a heavily annotated move is still *reported* as a rename; when it
    # is not, the add/delete pair below is matched by name instead, so the
    # threshold is no longer load-bearing either way.
    TICKET_STATUS="$(git diff --cached --name-status -M10% -- pipeline/tickets/)"
    REFUSAL="$(printf '%s\n' "$TICKET_STATUS" | awk -F'\t' '
      function id_of(path, prefix,    s) {
        s = path
        sub(prefix, "", s)
        return (s == path) ? "" : s
      }
      /^$/ { next }
      /^R/ {
        old = $2; new = $3
        old_id = id_of(old, "^pipeline/tickets/READY_FOR_ENGINEERING/")
        new_id = id_of(new, "^pipeline/tickets/DONE/")
        if (old_id == "" || new_id == "" || old_id != new_id) {
          print "  a move must be READY_FOR_ENGINEERING/<id>.md -> DONE/<id>.md, same <id>: " old " -> " new
        }
        next
      }
      /^D/ {
        removed[id_of($2, "^pipeline/tickets/READY_FOR_ENGINEERING/")] = 1
        if (id_of($2, "^pipeline/tickets/READY_FOR_ENGINEERING/") == "") {
          print "  deletion is not a ticket move: " $2
        }
        next
      }
      /^A/ {
        added[id_of($2, "^pipeline/tickets/DONE/")] = 1
        if (id_of($2, "^pipeline/tickets/DONE/") == "") {
          print "  addition is not a ticket move: " $2
        }
        next
      }
      { print "  only a ticket move may touch pipeline/tickets/ in a worktree: " $0 }
      END {
        # Fills the gap when git did not pair the add and the delete.
        for (id in removed) if (!(id in added)) print "  removed " id " but nothing with that name was added under DONE/"
        for (id in added) if (!(id in removed)) print "  added " id " under DONE/ but nothing with that name was removed from READY_FOR_ENGINEERING/"
      }')"
    if [ -n "$REFUSAL" ]; then
      echo ""
      echo "✗ Cannot commit pipeline/tickets/ changes inside a worktree branch."
      echo "  pipeline/tickets/ is managed exclusively in the main checkout, except"
      echo "  for a ticket's own READY_FOR_ENGINEERING → DONE move on its own branch,"
      echo "  which must keep the same file name."
      printf '%s\n' "$REFUSAL"
      echo "  If this is not the move you intended, unstage it:"
      echo "    git restore --staged pipeline/tickets/"
      exit 1
    fi
  fi
fi

# ── Merge commit: skip test run ───────────────────────────────────────────────
# The pipeline verifies tests explicitly before and after every merge.
# Running them again here on the merge commit is redundant.
GIT_DIR="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo ""
  echo "  (merge commit — tests already verified by pipeline)"
  exit 0
fi

# ── Bookkeeping commit: skip test run ─────────────────────────────────────────
# If every staged file is a ticket markdown, a doc, or the perf baseline,
# there is no code change to verify.
OTHER_FILES="$(git diff --cached --name-only \
  | grep -v '^pipeline/tickets/' \
  | grep -v '\.md$' \
  | grep -v '^devtools/perf/perf_baseline.json$' \
  || true)"
if [ -z "$OTHER_FILES" ]; then
  echo ""
  echo "  (no source code staged — skipping test suite)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
RUNNER="$REPO_ROOT/cli/platform/local/scripts/run_tests.sh"

if [ ! -x "$RUNNER" ]; then
  echo "✗ Test runner not found or not executable: $RUNNER"
  exit 1
fi

eval "$(opam env)"

# ── Infra detection ────────────────────────────────────────────────────────────
BROKER_UP=0;   rpk cluster info &>/dev/null 2>&1            && BROKER_UP=1
LOKI_UP=0;     curl -sf http://localhost:3100/ready &>/dev/null && LOKI_UP=1
POSTGRES_UP=0; bash -c 'echo > /dev/tcp/localhost/5432' &>/dev/null && POSTGRES_UP=1

# ── Build ──────────────────────────────────────────────────────────────────────
echo ""
echo "▶ pre-commit: build"
if ! dune build --root "$REPO_ROOT" 2>&1; then
  echo "✗ Build failed — commit blocked."
  exit 1
fi

# ── Helper: run a suite and exit on failure ────────────────────────────────────
run_suite() {
  local name="$1"
  echo ""
  echo "▶ pre-commit: $name"
  "$RUNNER" "$name" --no-infra
  local rc=$?
  if [ $rc -eq 1 ]; then
    echo ""
    echo "✗ ${name} tests failed — commit blocked."
    echo "  Skip once: SOL_SKIP_HOOKS=1 git commit ..."
    exit 1
  elif [ $rc -eq 2 ]; then
    echo ""
    echo "✗ Performance regression in ${name} suite — commit blocked."
    echo "  If intentional: bash $RUNNER ${name} --update-baseline"
    echo "  Skip once:      SOL_SKIP_HOOKS=1 git commit ..."
    exit 2
  fi
}

# ── Unit (always) ─────────────────────────────────────────────────────────────
run_suite unit

# ── Kafka (broker-conditional) ────────────────────────────────────────────────
if [ $BROKER_UP -eq 1 ]; then
  run_suite kafka
else
  echo ""
  echo "  (Redpanda not running — kafka + e2e tests skipped)"
  exit 0
fi

# ── E2e (all infra required) ──────────────────────────────────────────────────
if [ $LOKI_UP -eq 1 ] && [ $POSTGRES_UP -eq 1 ]; then
  run_suite e2e
else
  echo ""
  [ $LOKI_UP    -eq 0 ] && echo "  (Loki not running — e2e skipped)"
  [ $POSTGRES_UP -eq 0 ] && echo "  (Postgres not running — e2e skipped)"
fi

exit 0
