# `depends` is also used by the generated Dockerfile.
opam-version: "2.0"
synopsis: "{{Name}} -- a Sol workspace"
# TODO(you): fill these in before publishing this workspace anywhere. They are
# left as TODOs rather than guessed, the same way the rest of this scaffold
# leaves your project's identity to you.
maintainer: "TODO(your-email@example.com)"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0"}
  "sol-svc"
  "sol-svc-core"
  "sol-worker"
  "sol-fn"
  "sol-jobs"
  "sol-retry"
  "sol-obs"
  "kafka-eio-service"
]

# Track main for development; use published versions for reproducible builds.
pin-depends: [
  [ "sol-runtime.dev"       "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-env.dev"           "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-obs.dev"           "git+https://github.com/sol-fab/sol.git#main" ]
  [ "kafka-eio-service.dev" "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-svc.dev"           "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-svc-core.dev"      "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-worker.dev"        "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-fn.dev"            "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-jobs.dev"          "git+https://github.com/sol-fab/sol.git#main" ]
  [ "sol-retry.dev"         "git+https://github.com/sol-fab/sol.git#main" ]

  # opam does not apply dependency pins transitively. Keep source pins for
  # dependencies not yet published at the versions required by this workspace.
  [ "obs-loki-eio.0.2.0"  "git+https://github.com/loganbnielsen/obs-loki-eio.git#148a970651b299114b881bb382d3590caf8d38fa" ]
  [ "obs-tempo-eio.0.2.0" "git+https://github.com/loganbnielsen/obs-tempo-eio.git#e117aece43bd498ea4b2af62a4572f2f3c8fc93a" ]
  [ "pg-eio.0.1.0"        "git+https://github.com/loganbnielsen/pg-eio.git#0c47f9115fefd90524cce33e6c92e8c87f51cfa1" ]
  [ "lambda-eio.0.1.0"    "git+https://github.com/loganbnielsen/lambda-eio.git#4a0cf964238fbef87e4b691c067b958f4cfe35bd" ]

  # Published versions lag the framework's requirements; pin the required sources
  # until opam provides compatible releases.
  [ "https-eio.0.1.1"           "git+https://github.com/loganbnielsen/https-eio.git#e548f47cd8cc607e4781638fa3f4aec996b60d60" ]
  [ "kafka-eio.0.3.0"           "git+https://github.com/loganbnielsen/kafka-eio.git#3bb2d278896cee66a4e92dcaa7822c8832c1cc29" ]
  [ "obs-eio.0.1.2"             "git+https://github.com/loganbnielsen/obs-eio.git#b425c55eba8b1bc65378d7fc7d6c77a573001fb4" ]
  [ "obs-prometheus-eio.0.1.0"  "git+https://github.com/loganbnielsen/obs-prometheus-eio.git#5f443342fd20a36551336f27f7dbb93ab90e73bb" ]
]
