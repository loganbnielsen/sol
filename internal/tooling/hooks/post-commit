#!/usr/bin/env bash

[ "${SOL_SKIP_HOOKS:-0}" = "1" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel)"
PERF="$REPO_ROOT/internal/tooling/scripts/perf.sh"

[ -x "$PERF" ] || exit 0

bash "$PERF" status --regressions-only

_orphans=()
while IFS= read -r wt_path; do
  [ "$wt_path" = "$REPO_ROOT" ] && continue
  basename=$(basename "$wt_path")
  ticket_id=$(echo "$basename" | grep -oE '[A-Z]+-[0-9]+' | head -1)
  [ -z "$ticket_id" ] && continue
  if [ -f "$REPO_ROOT/internal/pipeline/tickets/DONE/${ticket_id}.md" ]; then
    _orphans+=("$wt_path")
  fi
done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')

if [ ${#_orphans[@]} -gt 0 ]; then
  echo ""
  echo "  ⚠  Orphaned worktrees (ticket is DONE — run: git worktree remove <path> --force):"
  for p in "${_orphans[@]}"; do
    echo "       $p"
  done
  echo ""
fi
