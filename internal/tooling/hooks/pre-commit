#!/usr/bin/env bash

[ "${SOL_SKIP_HOOKS:-0}" = "1" ] && exit 0

if ! "$(git rev-parse --show-toplevel)/internal/ci/check_authority.sh"; then
  exit 1
fi

GIT_DIR="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo ""
  echo "  (merge commit — tests already verified by pipeline)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ "$("$REPO_ROOT/internal/ci/classify-changes.sh" --staged)" = "docs-only" ]; then
  echo ""
  echo "  (docs-only — skipping format and build)"
  exit 0
fi
eval "$(opam env)"

echo ""
echo "▶ pre-commit: ocamlformat"
if ! "$REPO_ROOT/internal/ci/check_ocamlformat.sh" --staged; then
  echo "✗ Unformatted staged OCaml — commit blocked."
  echo "  Skip once: SOL_SKIP_HOOKS=1 git commit ..."
  exit 1
fi

echo ""
echo "  (build and repository checks run at push; required CI is authoritative)"
exit 0
