#!/usr/bin/env bash

[ "${SOL_SKIP_HOOKS:-0}" = "1" ] && exit 0

if ! "$(git rev-parse --show-toplevel)/internal/ci/check_authority.sh"; then
  exit 1
fi

STAGED_TICKETS="$(git diff --cached --name-only | grep -E '^(internal/)?pipeline/tickets/' || true)"
if [ -n "$STAGED_TICKETS" ]; then
  TICKET_STATUS="$(git diff --cached --name-status -M10% -- pipeline/tickets/ internal/pipeline/tickets/)"
  if ! REFUSAL="$(printf '%s\n' "$TICKET_STATUS" | "$(git rev-parse --show-toplevel)/internal/ci/context/check_ticket_transitions.sh")"; then
    echo ""
    echo "✗ Invalid pipeline ticket state change."
    printf '%s\n' "$REFUSAL"
    exit 1
  fi
fi

GIT_DIR="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo ""
  echo "  (merge commit — tests already verified by pipeline)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ "$("$REPO_ROOT/internal/ci/classify-changes.sh" --staged)" = "docs-only" ]; then
  echo ""
  echo "  (docs/tickets only — skipping format and build)"
  exit 0
fi
eval "$(opam env)"

echo ""
echo "▶ pre-commit: ocamlformat"
if ! "$REPO_ROOT/internal/ci/check_ocamlformat.sh" --staged; then
  echo "✗ Unformatted staged OCaml — commit blocked."
  echo "  Skip once: SOL_SKIP_HOOKS=1 git commit ..."
  exit 1
fi

echo ""
echo "▶ pre-commit: build"
if ! (unset $(git rev-parse --local-env-vars) && dune build --root "$REPO_ROOT" 2>&1); then
  echo "✗ Build failed — commit blocked."
  exit 1
fi

echo ""
echo "  (tests and the fast CI checks run at push: internal/ci/run_fast_checks.sh)"
exit 0
