#!/usr/bin/env bash
set -uo pipefail

[ "${SOL_SKIP_HOOKS:-0}" = "1" ] && exit 0
[ "${SOL_SKIP_PRE_PUSH:-0}" = "1" ] && exit 0

checks="internal/ci/run_fast_checks.sh"
root="$(git rev-parse --show-toplevel)"
unset $(git rev-parse --local-env-vars)

head_sha="$(git rev-parse HEAD 2>/dev/null || true)"
tips=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "${local_sha:-}" in "" | 0000000000000000000000000000000000000000) continue ;; esac
  case "$tips" in *"$local_sha"*) continue ;; esac
  tips="$tips$local_sha"$'\n'
done
[ -n "$tips" ] || tips="$head_sha"$'\n'

dirty="$(git status --porcelain --untracked-files=no)"
in_place=1
for sha in $tips; do
  [ "$sha" = "$head_sha" ] || in_place=0
done
[ -z "$dirty" ] || in_place=0

if [ "$in_place" = "1" ]; then
  exec bash "$root/$checks"
fi

if [ -n "$dirty" ]; then
  printf '%s\n' "pre-push: uncommitted changes here are NOT part of the pushed tree, so they cannot" \
    "          decide this push; the checks run against the pushed tip instead:"
  printf '%s\n' "$dirty" | sed 's/^/            /'
fi

status=0
for sha in $tips; do
  tmp="$(mktemp -d)"
  printf '%s\n' "pre-push: evaluating pushed tip ${sha} in a clean worktree"
  if ! git worktree add --detach --quiet "$tmp" "$sha"; then
    printf '%s\n' "pre-push: could not create a worktree for $sha" >&2
    rm -rf "$tmp"
    exit 1
  fi
  if ! ( cd "$tmp" && bash "$checks" ); then
    status=1
  fi
  git worktree remove --force "$tmp" >/dev/null 2>&1 || true
done
exit "$status"
