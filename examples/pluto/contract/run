#!/bin/sh
# The pluto workspace has two event languages: the OCaml events in
# contract/contract.exe and the TypeScript demo's contract package. Dispatch on
# the requested scope so a single-language scope needs only that language's
# toolchain, the way a single-language workspace would.
scope=""
previous=""
for argument in "$@"; do
  if [ "$previous" = "--scope" ]; then scope="$argument"; fi
  previous="$argument"
done

case "$scope" in
  demo_ts|demo_ts/*)
    exec npm --prefix app/demo_ts run --silent contract -- "$@"
    ;;
  payments|payments/*|comms|comms/*|orders|orders/*|checkout|checkout/*)
    exec dune exec ./contract/contract.exe -- "$@"
    ;;
  *)
    # A workspace-wide deploy starts every scope this workspace declares, so it
    # must register every scope's contracts: the OCaml events here first, then
    # the TypeScript scope's, whose units fatally verify theirs at startup.
    dune exec ./contract/contract.exe -- "$@" || exit $?
    exec npm --prefix app/demo_ts run --silent contract -- "$@"
    ;;
esac
