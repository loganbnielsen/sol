# Hand-written because Dune cannot generate `pin-depends`.
# Pins target immutable commits; remove them when dependencies are published.
opam-version: "2.0"
synopsis: "Sol's observability conventions: metric names, label vocabularies, Loki push shape, W3C traceparent propagation"
authors: "Logan Nielsen"
maintainer: "Logan Nielsen <lbendtlynielsen@gmail.com>"
license: "Apache-2.0"
homepage: "https://github.com/sol-fab/sol"
bug-reports: "https://github.com/sol-fab/sol/issues"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0"}
  "eio" "obs-eio" "obs-loki-eio" "obs-prometheus-eio" "obs-tempo-eio"
  "sol-runtime" {with-test}
]
pin-depends: [
  [ "obs-loki-eio.0.2.0"  "git+https://github.com/loganbnielsen/obs-loki-eio.git#148a970651b299114b881bb382d3590caf8d38fa" ]
  [ "obs-tempo-eio.0.2.0" "git+https://github.com/loganbnielsen/obs-tempo-eio.git#e117aece43bd498ea4b2af62a4572f2f3c8fc93a" ]
]
build: [
  [ "dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} ]
]
