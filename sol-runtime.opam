# Hand-written because Dune cannot generate `pin-depends`.
# Pins target immutable commits; remove them when dependencies are published.
opam-version: "2.0"
synopsis: "Internal: Sol's shared runtime plumbing. Not part of the supported application API"
authors: "Logan Nielsen"
maintainer: "Logan Nielsen <lbendtlynielsen@gmail.com>"
license: "Apache-2.0"
homepage: "https://github.com/loganbnielsen/sol"
bug-reports: "https://github.com/loganbnielsen/sol/issues"
depends: [ "ocaml" {>= "5.4.0"} "dune" {>= "3.0"} "eio" ]
build: [
  [ "dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} ]
]
