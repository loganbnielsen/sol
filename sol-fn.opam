# HAND-WRITTEN, not generated by Dune -- see dune-project.
#
# DEC-025: the framework packages are one coordinated release train. `pin-depends`
# is used where a dependency is not yet in the public opam-repository; Dune's
# generator cannot express it, which is why generation is disabled. RELEASE-005
# removes these entries as the dependencies are published.
#
# Pin target: immutable commit SHAs (stronger than a movable tag).
opam-version: "2.0"
synopsis: "Sol's scheduled-function application shape"
authors: "Logan Nielsen"
maintainer: "Logan Nielsen <lbendtlynielsen@gmail.com>"
license: "Apache-2.0"
homepage: "https://github.com/loganbnielsen/sol"
bug-reports: "https://github.com/loganbnielsen/sol/issues"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.0"}
  "eio" "lambda-eio" "obs-eio" "obs-prometheus-eio"
  "sol-env" "sol-obs" "sol-runtime"
]
pin-depends: [
  [ "lambda-eio.0.1.0" "git+https://github.com/loganbnielsen/lambda-eio.git#c07c367b0f8919ae6efb9c3af2cd39d9061b1fdd" ]
]
build: [
  [ "dune" "subst" ] {dev}
  [ "dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} ]
]
