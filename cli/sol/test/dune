 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/sol/prod/aws\"\ncat > \"$tmp/sol/prod/aws/us-east-1.yml\" <<'EOF'\ntarget:\n  kube_context: prod-us-east-1\nEOF\ncd \"$tmp\"\ntouch \"$tmp/sol.yml\"\nif \"$sol\" target show >\"$tmp/out\" 2>&1; then\n  echo 'sol target show ran without naming a target' >&2\n  exit 1\nfi\ngrep -F 'available targets:' \"$tmp/out\" >/dev/null")))

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/sol/prod/aws\"\ncat > \"$tmp/sol/prod/aws/us-east-1.yml\" <<'EOF'\ntarget:\n  kube_context: no-such-context-xyz\nEOF\ncd \"$tmp\"\ntouch \"$tmp/sol.yml\"\nout=$(\"$sol\" target show --target prod/aws/us-east-1 --check)\necho \"$out\" | grep -F 'unreachable' >/dev/null\nif echo \"$out\" | grep -F 'no-such-context-xyz' >/dev/null; then\n  echo 'sol target show --check leaked the kube-context in the default output' >&2\n  exit 1\nfi\n\"$sol\" target show --target prod/aws/us-east-1 --check --verbose | grep -F 'no-such-context-xyz' >/dev/null\nif command -v kubectl >/dev/null 2>&1; then\n  \"$sol\" target show --target prod/aws/us-east-1 --check --verbose | grep -F 'does not exist' >/dev/null\nfi")))

; FEAT-089: a profile target is refused before any cluster call or emitted file.

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\nroot=$(mktemp -d)\ntrap 'rm -rf \"$root\"' EXIT\ntmp=\"$root/pluto\"\nmkdir -p \"$tmp/app/payments/charge_svc\" \"$tmp/sol/prod/aws\"\necho 'FROM scratch' > \"$tmp/app/payments/charge_svc/Dockerfile\"\ntouch \"$tmp/app/payments/charge_svc/sol.toml\"\necho 'project: pluto' > \"$tmp/sol.yml\"\nprintf 'target:\\n  profile: production-single-region\\n  registry: registry.example.com\\n  kube_context: feat089-no-such-context\\n' > \"$tmp/sol/prod/aws/us-east-1.yml\"\ncd \"$tmp\"\nif \"$sol\" deploy prod/aws/us-east-1 --emit-to out --image-tag abc >\"$tmp/emit.out\" 2>&1; then\n  echo 'profile target unexpectedly emitted a GitOps bundle' >&2\n  exit 1\nfi\ngrep -F 'Nothing was changed' \"$tmp/emit.out\" >/dev/null\ngrep -F 'direct apply reconciliation authority is not established' \"$tmp/emit.out\" >/dev/null\ntest ! -e out\nif POSTGRES_URL=postgres://unused \"$sol\" deploy prod/aws/us-east-1 --image-tag abc >\"$tmp/apply.out\" 2>&1; then\n  echo 'profile target unexpectedly deployed' >&2\n  exit 1\nfi\ngrep -F 'preflight found' \"$tmp/apply.out\" >/dev/null\nif grep -F 'feat089-no-such-context' \"$tmp/apply.out\" >/dev/null; then\n  echo 'preflight ran after a cluster call' >&2\n  exit 1\nfi")))

