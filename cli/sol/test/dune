(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\ncat > \"$tmp/sol.yml\" <<'EOF'\nservices:\n  api:\n    uses: [/us-east-1/analytics_db]\nEOF\ncd \"$tmp\"\n\"$sol\" plan prod/aws/us-east-1 | grep -F 'uses: /us-east-1/analytics_db (cross-region)' >/dev/null")))

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/app/payments/charge_svc\"\ncat > \"$tmp/app/payments/charge_svc/Dockerfile\" <<'EOF'\nFROM scratch\nEOF\ncd \"$tmp\"\n\"$sol\" check >\"$tmp/ok.out\"\nrm \"$tmp/app/payments/charge_svc/Dockerfile\"\nif \"$sol\" check >\"$tmp/bad.out\" 2>&1; then\n  echo 'sol check unexpectedly passed without Dockerfile' >&2\n  exit 1\nfi\ngrep -F 'Dockerfile is missing' \"$tmp/bad.out\" >/dev/null")))
