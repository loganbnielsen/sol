; INFRA-035: the readiness checks' kubectl argv, validated against a real
; kubectl. The lifecycle harness below cannot cover this: its fake kubectl
; accepts any argv, which is how `rollout status … --all` — a flag kubectl does
; not have — made every platform report `Unmet` on a real target.

(rule
 (alias runtest)
 (deps
  print_readiness_invocations.exe
  ../../internal/ci/check_readiness_invocations.sh)
 (action
  (pipe-stdout
   (run %{dep:print_readiness_invocations.exe})
   (run bash %{dep:../../internal/ci/check_readiness_invocations.sh}))))

(rule
 (alias runtest)
 (deps
  ../bin/main.exe
  ../../internal/ci/test_cloud_lifecycle_offline.sh
  ../../internal/ci/qualification_assertions.sh)
 (action
  (run
   bash
   %{dep:../../internal/ci/test_cloud_lifecycle_offline.sh}
   %{dep:../bin/main.exe})))

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\ncat > \"$tmp/sol.yml\" <<'EOF'\nservices:\n  api:\n    uses: [/us-east-1/analytics_db]\nEOF\ncd \"$tmp\"\n\"$sol\" plan prod/aws/us-east-1 | grep -F 'uses: /us-east-1/analytics_db (cross-region)' >/dev/null")))

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/app/payments/charge_svc\"\ncat > \"$tmp/app/payments/charge_svc/Dockerfile\" <<'EOF'\nFROM scratch\nEOF\ncd \"$tmp\"\ntouch \"$tmp/sol.yml\"\n\"$sol\" check >\"$tmp/ok.out\"\nrm \"$tmp/app/payments/charge_svc/Dockerfile\"\nif \"$sol\" check >\"$tmp/bad.out\" 2>&1; then\n  echo 'sol check unexpectedly passed without Dockerfile' >&2\n  exit 1\nfi\ngrep -F 'Dockerfile is missing' \"$tmp/bad.out\" >/dev/null")))

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/sol\"\ncat > \"$tmp/sol/environments.yml\" <<'EOF'\nprod:\n  targets:\n    aws/us-east-1:\n      kube_context: prod-us-east-1\nEOF\ncd \"$tmp\"\ntouch \"$tmp/sol.yml\"\nout=$(\"$sol\" target show --target prod/aws/us-east-1)\necho \"$out\" | grep -F 'us-east-1' >/dev/null\nif echo \"$out\" | grep -F 'prod-us-east-1' >/dev/null; then\n  echo 'sol target show leaked the kube-context without --verbose' >&2\n  exit 1\nfi\n\"$sol\" target show --target prod/aws/us-east-1 --verbose | grep -F 'prod-us-east-1' >/dev/null\nif \"$sol\" target show --target prod/aws/nope >\"$tmp/bad.out\" 2>&1; then\n  echo 'sol target show accepted an unknown target' >&2\n  exit 1\nfi\ngrep -F 'available targets:' \"$tmp/bad.out\" >/dev/null\ngrep -F 'prod/aws/us-east-1' \"$tmp/bad.out\" >/dev/null")))

