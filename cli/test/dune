; REFAC-117: `sol alert test` -- --target is required at the command line (a
; usage error, exit 124), a target failing the alert contract exits 2, and a dry
; run prints the synthetic alert without sending it.

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -u\nsol=$(pwd)/%{deps}\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\ncd \"$tmp\"\ntouch sol.yml\nmkdir sol\nexpect() { want=$1; shift; if \"$sol\" \"$@\" >out 2>&1; then got=0; else got=$?; fi; if [ \"$got\" != \"$want\" ]; then echo \"sol $*: expected exit $want, got $got\" >&2; cat out >&2; exit 1; fi; }\nexpect 124 alert test\ngrep -F -- '--target' out >/dev/null\nprintf 'prod:\\n  targets:\\n    aws/us-east-1:\\n' > sol/environments.yml\nexpect 2 alert test --target prod/aws/us-east-1\ngrep -F 'does not satisfy the alert-delivery contract' out >/dev/null\nprintf 'prod:\\n  targets:\\n    aws/us-east-1:\\n      alert_receiver_type: webhook\\n      alert_receiver_url: https://hooks.example.test/x\\n      alert_owner: ops@example.test\\n      alert_runbook_url: https://runbooks.example.test/x\\n' > sol/environments.yml\nexpect 0 alert test --target prod/aws/us-east-1 --dry-run\ngrep -F '\"alertname\":\"SolSyntheticAlert\"' out >/dev/null\ngrep -F '/api/v2/alerts' out >/dev/null")))

; REFAC-115: `sol assets` runs every check and reports every failure, then fails
; once -- here with two assets broken in a copy of the platform tree.

(rule
 (alias runtest)
 (deps
  ../bin/main.exe
  (source_tree ../../platform))
 (action
  (bash
   "set -u\nsol=$(pwd)/../bin/main.exe\nplatform=$(pwd)/../../platform\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p \"$tmp/home/framework/ocaml/sol-svc/lib\" \"$tmp/home/framework/ocaml/kafka-eio-service/lib\"\ntouch \"$tmp/home/framework/ocaml/sol-svc/lib/dune\" \"$tmp/home/framework/ocaml/kafka-eio-service/lib/dune\"\ncp -r \"$platform\" \"$tmp/home/platform\"\nchmod -R u+w \"$tmp/home\"\nrm -rf \"$tmp/home/platform/shared/observability/dashboards\" \"$tmp/home/platform/cloud/aws/cluster\"\nif SOL_HOME=\"$tmp/home\" \"$sol\" assets >\"$tmp/out\" 2>&1; then\n  echo 'sol assets passed with two assets broken' >&2; cat \"$tmp/out\" >&2; exit 1\nfi\nfailed=$(grep -c '^  FAIL ' \"$tmp/out\" || true)\nif [ \"$failed\" -lt 2 ]; then\n  echo \"sol assets reported $failed failure(s), expected both\" >&2; cat \"$tmp/out\" >&2; exit 1\nfi\ngrep -F 'FAIL  terraform' \"$tmp/out\" >/dev/null\ngrep -F 'FAIL  dashboards' \"$tmp/out\" >/dev/null\ngrep -F 'ok  terraform  platform/cloud/gcp/cluster' \"$tmp/out\" >/dev/null\ngrep -F 'asset checks failed' \"$tmp/out\" >/dev/null")))

; REFAC-115 (part B): commands return their failure and exit once, at the term,
; with the same text and exit code as before. Usage errors (an unknown
; observability backend, --follow with --no-follow) are the parser's, so 124.

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/../bin/main.exe\ntmp=$(mktemp -d)\ntrap 'rm -rf \"$tmp\"' EXIT\nexpect() {\n  want=$1; shift\n  if \"$@\" >\"$tmp/out\" 2>\"$tmp/err\"; then got=0; else got=$?; fi\n  if [ \"$got\" != \"$want\" ]; then\n    echo \"expected exit $want, got $got: $*\" >&2; cat \"$tmp/err\" >&2; exit 1\n  fi\n}\nmkdir -p \"$tmp/outside\" \"$tmp/ws/app/payments/charge_svc\"\ncd \"$tmp/outside\"\nexpect 1 \"$sol\" check\ngrep -F 'sol: not inside a Sol workspace' \"$tmp/err\" >/dev/null\ncd \"$tmp/ws\"\ntouch sol.yml\nexpect 1 \"$sol\" check\ngrep -F 'Dockerfile is missing' \"$tmp/err\" >/dev/null\nif [ -n \"$(tail -n 1 \"$tmp/err\")\" ]; then :; else echo 'sol check printed a blank line after its findings' >&2; exit 1; fi\nexpect 124 \"$sol\" open logs --links --observability-backend bogus\ngrep -F 'bogus' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" local rollback\ngrep -Fx 'error: pass a release id, or --commit <sha>.' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" plan nope\ngrep -Fx 'error: nope: target must look like <env>/<provider>/<region>' \"$tmp/err\" >/dev/null\nmkdir -p app/billing/invoice_svc\necho 'FROM scratch' > app/billing/invoice_svc/Dockerfile\nexpect 1 \"$sol\" local fn run billing/invoice_svc\ngrep -F \"is a svc, not a -fn; 'sol fn run' only invokes -fn workloads.\" \"$tmp/err\" >/dev/null\nexpect 124 \"$sol\" local logs --scope billing/invoice_svc --follow --no-follow\ngrep -F -- '--follow and --no-follow are mutually exclusive' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" local logs\ngrep -Fx 'error: pass --scope DOMAIN/UNIT (or --release <id>)' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" local logs --scope billing\ngrep -F 'error: sol logs addresses exactly one unit' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" deploy prod/aws/us-east-1 --dry-run --image-tag t1\ngrep -F 'error: target \"prod/aws/us-east-1\" is not declared in' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" local migrate --dry-run --dir nope\ngrep -Fx 'error: cannot read migrations dir: nope: No such file or directory' \"$tmp/err\" >/dev/null\nmkdir -p m && touch m/001_a.sql m/001_b.sql\nexpect 1 \"$sol\" local migrate --dry-run --dir m\ngrep -F 'error: migrations 001_a.sql and 001_b.sql in m share version 1' \"$tmp/err\" >/dev/null\nif command -v terraform >/dev/null 2>&1; then\n  expect 1 \"$sol\" cloud plan nope\n  grep -Fx 'error: target must look like <env>/<provider>/<region>.' \"$tmp/err\" >/dev/null\n  expect 1 \"$sol\" cloud plan prod/zzz/us-east-1\n  grep -Fx 'error: unsupported provider \"zzz\" in target \"prod/zzz/us-east-1\".' \"$tmp/err\" >/dev/null\nfi\nexpect 1 \"$sol\" new svc bad\ngrep -Fx 'error: expected domain/name (e.g. payments/charge), got \"bad\"' \"$tmp/err\" >/dev/null\nexpect 1 \"$sol\" new workspace sol.yml\ngrep -Fx 'error: \"sol.yml\" already exists' \"$tmp/err\" >/dev/null\nexpect 124 \"$sol\" local rollback --commit \"\"\ngrep -F 'must not be blank' \"$tmp/err\" >/dev/null\nexpect 124 \"$sol\" open logs --links --observability-backend self_hosted_durable --base-domain \"  \"\ngrep -F 'must not be blank' \"$tmp/err\" >/dev/null\n")))

