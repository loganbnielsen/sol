; FEAT-089: a profile target is refused before any cluster call or emitted file.

(rule
 (alias runtest)
 (deps ../bin/main.exe)
 (action
  (bash
   "set -eu\nsol=$(pwd)/%{deps}\nroot=$(mktemp -d)\ntrap 'rm -rf \"$root\"' EXIT\ntmp=\"$root/pluto\"\nmkdir -p \"$tmp/app/payments/charge_svc\" \"$tmp/sol\"\necho 'FROM scratch' > \"$tmp/app/payments/charge_svc/Dockerfile\"\ntouch \"$tmp/app/payments/charge_svc/sol.toml\"\necho 'project: pluto' > \"$tmp/sol.yml\"\nprintf 'prod:\\n  targets:\\n    aws/us-east-1:\\n      profile: production-single-region\\n      registry: registry.example.com\\n      kube_context: feat089-no-such-context\\n' > \"$tmp/sol/environments.yml\"\ncd \"$tmp\"\nif \"$sol\" deploy prod/aws/us-east-1 --emit-to out --image-tag abc >\"$tmp/emit.out\" 2>&1; then\n  echo 'profile target unexpectedly emitted a GitOps bundle' >&2\n  exit 1\nfi\ngrep -F 'Nothing was changed' \"$tmp/emit.out\" >/dev/null\ngrep -F 'direct apply reconciliation authority is not established' \"$tmp/emit.out\" >/dev/null\ntest ! -e out\nif POSTGRES_URL=postgres://unused \"$sol\" deploy prod/aws/us-east-1 --image-tag abc >\"$tmp/apply.out\" 2>&1; then\n  echo 'profile target unexpectedly deployed' >&2\n  exit 1\nfi\ngrep -F 'preflight found' \"$tmp/apply.out\" >/dev/null\nif grep -F 'feat089-no-such-context' \"$tmp/apply.out\" >/dev/null; then\n  echo 'preflight ran after a cluster call' >&2\n  exit 1\nfi")))

