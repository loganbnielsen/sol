; The qualification-artifact guard is internal/ci/check_no_account_artifacts.sh
; and runs as a CI step, not here: it checks what git tracks, and dune can only
; offer it `_build/default`, where `git ls-files` is empty and it would pass on
; any tree at all.

; INFRA-075 guard: the isolation above must stay in force, and must not point at the
; operator's real data home.

(rule
 (alias runtest)
 (action
  (bash
   "set -eu\ncase \"${XDG_DATA_HOME:-}\" in\n  '') echo 'INFRA-075: XDG_DATA_HOME is unset for cli/test actions; sol would write runs into the real ~/.local/share/sol' >&2; exit 1 ;;\nesac\nif [ -n \"${HOME:-}\" ] && [ \"$(cd \"$(dirname \"$XDG_DATA_HOME\")\" 2>/dev/null && pwd -P)/$(basename \"$XDG_DATA_HOME\")\" = \"$HOME/.local/share\" ]; then\n  echo 'INFRA-075: XDG_DATA_HOME points at the real data home' >&2; exit 1\nfi")))

